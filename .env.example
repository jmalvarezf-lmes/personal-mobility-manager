TOYOTA_LOCALE=es-es

# PostgreSQL connection DSN
POSTGRES_DSN=postgresql://mobility:mobility@localhost:5432/mobility_manager

# Madrid SER zone boundary shapefile URL (SER_BANDA_APARCAMIENTO curb-band polylines)
SER_ZONE_SHP_URL=https://geoportal.madrid.es/fsdescargas/IDEAM_WBGEOPORTAL/MOVILIDAD/ZONA_SER/SHP_ZIP.zip

# Madrid Callejero CSV URL — used to resolve administrative zone number, street name, and district
MADRID_CALLEJERO_URL=https://datos.madrid.es/dataset/200075-0-callejero/resource/200075-1-callejero-csv/download/200075-1-callejero-csv.csv

# Madrid Barrios administrative boundary shapefile URL — used to resolve each SER zone_number's
# presentation-only frontier polygon and neighbourhood name (see add-ser-zone-frontiers design.md)
MADRID_BARRIOS_SHP_URL=https://geoportal.madrid.es/fsdescargas/IDEAM_WBGEOPORTAL/LIMITES_ADMINISTRATIVOS/Barrios/Barrios.zip

# Ingestion interval in hours (default: 24)
INGESTION_INTERVAL_HOURS=24

# Root logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# OpenStreetMap self-hosted tile server URL (leave empty to use public OSM tiles via the frontend fallback)
OSM_TILE_URL=

# Allowed CORS origins for the frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Google OAuth2 credentials
# Create credentials at https://console.cloud.google.com/ → APIs & Services → Credentials
# Add GOOGLE_REDIRECT_URI as an Authorized Redirect URI in the Google Cloud Console
#
# Docker (port 3000):  GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Vite dev (port 5173): GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Direct backend:      GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Fernet encryption key for Toyota vehicle credentials and SER ticket provider
# sessions. REQUIRED whenever "toyota" is in ENABLED_BRANDS or "elparking" is
# in ENABLED_SER_PROVIDERS (elparking is enabled by default — see below), so
# in practice this must be set in every deployment.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Enabled SER (parking permit) ticket providers, comma-separated (default: elparking)
ENABLED_SER_PROVIDERS=elparking

# ElParking API base URL — REQUIRED when "elparking" is enabled (no default;
# the real base URL must be supplied per deployment).
ELPARKING_API_BASE_URL=

# ep-app-version sent to ElParking's login API. Optional — defaults to "26.2".
# Expected to evolve over time as this integration matures.
ELPARKING_APP_VERSION=26.2

# Fallback minimum movement distance (metres) used to resolve a user's
# effective threshold_m for a notification type when they haven't set their
# own override via PUT /notifications/preferences/{type_key} (default: 50).
# Renamed from NOTIFICATION_MOVEMENT_THRESHOLD_METERS — see
# add-notification-type-preferences (BREAKING: rename this var on deploy).
DEFAULT_NOTIFICATION_MOVEMENT_THRESHOLD_METERS=50

# Telegram notification channel — REQUIRED (no defaults) in every deployment,
# since the Telegram channel is constructed unconditionally at startup.
# Create a bot via @BotFather to obtain a token and username, then register a
# webhook (Telegram's setWebhook API) with a secret_token matching
# TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# SER zone containment tolerance in centimetres (default: 50). Compensates
# for GPS positioning error when checking whether a vehicle's location falls
# within a SER zone's stored polygon boundary.
SER_ZONE_CONTAINMENT_TOLERANCE_CM=50

# Thread pool size for InMemoryEventPublisher's asynchronous event-handler
# dispatch (default: 4) — e.g. handlers reacting to VehicleLocationUpdated,
# including ones that make outbound SER ticket provider HTTP calls.
EVENT_PUBLISHER_MAX_WORKERS=4

# OpenTelemetry observability (traces + metrics only — no logs are ever
# exported via OTel). These are STANDARD OTel environment variable names,
# copy-pasteable directly from Grafana Cloud's own OTLP onboarding page
# (Basic Auth: "instance ID:API token", base64-encoded into the Authorization
# header value below) — no translation layer needed.
#
# Activation is implicit: leave OTEL_EXPORTER_OTLP_ENDPOINT unset/empty to
# run with observability fully inactive (no traces/metrics collected, no
# auto-instrumentation of FastAPI/httpx/SQLAlchemy, zero export overhead,
# app starts and runs identically either way).
# Server-side session cleanup (add-session-revocation): how long a
# revoked-or-expired sessions row survives before the scheduled cleanup job
# purges it (default: 30 days), and how often that job runs (default: 24h).
SESSION_CLEANUP_RETENTION_DAYS=30
SESSION_CLEANUP_INTERVAL_HOURS=24

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Trace sampling. Defaults to 25% (ParentBased(TraceIdRatioBased(0.25))) when
# unset — override the ratio via OTEL_TRACES_SAMPLER_ARG (0.0-1.0).
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.25
